# Contact form — optional. Without these the form still works in dev:
# submissions are logged to the server console instead of emailed.

# Get a key at https://resend.com  (free tier is plenty for a contact form)
RESEND_API_KEY=

# Where enquiries land. Defaults to site.email in content/site.ts
CONTACT_TO=

# Verified sender. Until you verify a domain in Resend, use onboarding@resend.dev
CONTACT_FROM="Problexa site <onboarding@resend.dev>"
